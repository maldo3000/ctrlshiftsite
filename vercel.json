{
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/academy/(.*)\\.(jpg|png|svg|woff2|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/asmbly/(.*)\\.(webp|jpg|png|mp4|woff2|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/asmbly",
      "destination": "/asmbly/index.html"
    },
    {
      "source": "/asmbly/",
      "destination": "/asmbly/index.html"
    },
    {
      "source": "/academy/sample-coursebook",
      "destination": "/academy/sample-coursebook/index.html"
    },
    {
      "source": "/academy/sample-coursebook/",
      "destination": "/academy/sample-coursebook/index.html"
    },
    {
      "source": "/academy",
      "destination": "/academy/index.html"
    },
    {
      "source": "/academy/",
      "destination": "/academy/index.html"
    },
    {
      "source": "/rawclaw",
      "destination": "/rawclaw/index.html"
    },
    {
      "source": "/rawclaw/",
      "destination": "/rawclaw/index.html"
    },
    {
      "source": "/launch",
      "destination": "/index.html"
    },
    {
      "source": "/launch/",
      "destination": "/index.html"
    },
    {
      "source": "/volunteer",
      "destination": "/index.html"
    },
    {
      "source": "/volunteer/",
      "destination": "/index.html"
    },
    {
      "source": "/sponsors",
      "destination": "/index.html"
    },
    {
      "source": "/sponsors/",
      "destination": "/index.html"
    },
    {
      "source": "/sponsors/login",
      "destination": "/index.html"
    },
    {
      "source": "/sponsors/login/",
      "destination": "/index.html"
    },
    {
      "source": "/sponsors/vol-9",
      "destination": "/index.html"
    },
    {
      "source": "/sponsors/vol-9/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/con",
      "destination": "/asmbly",
      "permanent": false
    },
    {
      "source": "/con/:path*",
      "destination": "/asmbly/:path*",
      "permanent": false
    },
    {
      "source": "/conference",
      "destination": "/asmbly",
      "permanent": false
    }
  ]
}
